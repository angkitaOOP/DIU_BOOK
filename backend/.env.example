NODE_ENV=development
PORT=5000
# Comma-separated list of allowed frontend origins
CLIENT_URL=http://localhost:5173

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=diulink

# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string_at_least_32_chars
JWT_EXPIRES_IN=7d

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Leave SMTP_HOST empty in development: OTP codes are printed in the server console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="DIULink <no-reply@diulink.app>"

# Used by `npm run db:seed` to create the first admin account (must be a @diu.edu.bd email)
SEED_ADMIN_EMAIL=admin@diu.edu.bd
SEED_ADMIN_PASSWORD=ChangeThisAdminPassword123
